# Godot 4+ specific ignores
.godot/
/android/

# .NET / Godot Mono build output
.mono/
bin/
obj/
*.user

# The engine's derived trees: `paradise assets build` writes build/, the editor's play tree and
# caches live under .editor/. assets/ is the source of truth and is committed, sidecars included.
/build/
/.editor/

# JetBrains IDE
.idea/

# Symlink to the reference ParadiseEngine repo (local-only)
/ParadiseEngine

# Claude Code worktrees (local-only)
/.claude/worktrees/

# macOS
.DS_Store
