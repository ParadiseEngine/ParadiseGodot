# Godot 4+ specific ignores
.godot/
/android/

# .NET / Godot Mono build output
.mono/
bin/
obj/
*.user

# Exported engine-neutral data (build output; regenerate via Paradise/Export or the
# PARADISE_EXPORT_SCENE headless hook). The sample fixture set IS tracked (force-added): the
# scene contract (data/scenes/sample.*), materials (data/materials/*.json), the shared unit
# primitive GLBs (data/primitives/*.glb, from Paradise/Generate Primitive GLBs), the source model
# GLBs the scene references (data/Models/**/*.glb — geometry only), and their EXTERNAL texture
# sidecars (data/Models/**/*.ktx2, <glbstem>_<i>.ktx2, from Paradise/Convert data GLBs → KTX2).
# A GLB and its .ktx2 sidecars must be committed together (relative image URIs). These back
# ParadiseExport.Tests / ParadiseRuntime(.Tests) and the engine's real-producer GLB cross-checks.
# NOT tracked: Godot import sidecars (*.import, *.uid) and any extracted texture PNGs — regenerated
# on import.
/data/

# JetBrains IDE
.idea/

# Symlink to the reference ParadiseEngine repo (local-only)
/ParadiseEngine
