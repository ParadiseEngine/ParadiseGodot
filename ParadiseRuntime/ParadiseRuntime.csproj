<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>ParadiseRuntime</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ParadiseGame\ParadiseGame.csproj" />
    <ProjectReference Include="..\ParadiseGame.Navigation.Detour\ParadiseGame.Navigation.Detour.csproj" />
    <ProjectReference Include="..\ParadiseExport\ParadiseExport.csproj" />
    <!-- Real sibling paths (NOT the in-tree ParadiseEngine symlink, which breaks restore). -->
    <ProjectReference Include="..\..\ParadiseEngine\src\Paradise.Rendering\Paradise.Rendering.csproj" />
    <ProjectReference Include="..\..\ParadiseEngine\src\Paradise.Rendering.WebGPU\Paradise.Rendering.WebGPU.csproj" />
    <ProjectReference Include="..\..\ParadiseEngine\src\Paradise.Rendering.Pbr\Paradise.Rendering.Pbr.csproj" />
    <ProjectReference Include="..\..\ParadiseEngine\src\Paradise.Assets.Gltf\Paradise.Assets.Gltf.csproj" />
    <ProjectReference Include="..\..\ParadiseEngine\src\Paradise.Assets.Textures\Paradise.Assets.Textures.csproj" />
    <ProjectReference Include="..\..\ParadiseEngine\src\Paradise.Ui.ImGui\Paradise.Ui.ImGui.csproj" />
    <ProjectReference Include="..\..\ParadiseEngine\src\Paradise.Ui.Noesis\Paradise.Ui.Noesis.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ppy.SDL3-CS" Version="2026.320.0" />
  </ItemGroup>

</Project>
