<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Engine-agnostic runtime simulation shared between the Godot presentation (ParadiseGodot) and the
    Paradise Engine runtime — the "BankHeist.Core" analog. NO Godot / DotRecast references: it depends
    only on Paradise.ECS. All logic is right-handed (Y-up, −Z forward), matching the export contract.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>ParadiseGame</RootNamespace>
    <!-- Required so Godot can load this library into its collectible assembly load context. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Real sibling path (NOT the in-tree ParadiseEngine symlink, which breaks .editorconfig/restore). -->
    <ProjectReference Include="..\..\ParadiseEngine\src\Paradise.ECS\Paradise.ECS.csproj" />
    <ProjectReference Include="..\..\ParadiseEngine\src\Paradise.ECS.Generators\Paradise.ECS.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\ParadiseEngine\src\Paradise.Physics\Paradise.Physics.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Paradise.ECS" />
  </ItemGroup>

</Project>
