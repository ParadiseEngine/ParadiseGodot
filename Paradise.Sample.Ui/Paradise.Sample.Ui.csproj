<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Paradise.Sample.Ui</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Font-atlas pixel copy from cimgui's unmanaged buffer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Loaded into Godot's collectible AssemblyLoadContext, like Paradise.Sample.Pool. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Sample.Pool\Paradise.Sample.Pool.csproj" />
    <!-- The "Space Odyssey" ECS sim core the OdysseyViewModel projects. -->
    <ProjectReference Include="..\Paradise.Sample.Odyssey\Paradise.Sample.Odyssey.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The engine-neutral UI input contract ImGuiUiCore's sim half implements. -->
    <PackageReference Include="Paradise.Ui" Version="0.35.0" />
    <!-- Published engine package; brings ImGui.NET + WebGPUSharp transitively
         (ImGuiDrawSnapshot lives there). -->
    <PackageReference Include="Paradise.Ui.ImGui" Version="0.35.0" />
  </ItemGroup>

</Project>
