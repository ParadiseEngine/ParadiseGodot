<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Paradise.Sample.Ui</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Font-atlas pixel copy from cimgui's unmanaged buffer. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Loaded into Godot's collectible AssemblyLoadContext, like Paradise.Sample.Game. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Sample.Game\Paradise.Sample.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Published engine package; brings ImGui.NET + WebGPUSharp transitively
         (ImGuiDrawSnapshot lives there). -->
    <PackageReference Include="Paradise.Ui.ImGui" Version="0.2.0" />
    <!-- Pinned to the engine's version (ParadiseEngine/src/Directory.Packages.props). -->
    <PackageReference Include="Noesis.GUI" Version="3.2.12" />
  </ItemGroup>

</Project>
