<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DotRecast implementation of ParadiseGame.Core's INavigationMesh — the single shared nav backend
    used by BOTH the Godot presentation and the Paradise Engine runtime (the BankHeist.Navigation.Detour
    analog). Engine-agnostic; right-handed. Reuses ParadiseExport.Core's NavMeshBinaryWriter.BuildNavMesh
    to turn RH triangles into a queryable DtNavMesh.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ParadiseGame.Navigation.Detour</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ParadiseGame.Core\ParadiseGame.Core.csproj" />
    <ProjectReference Include="..\ParadiseExport.Core\ParadiseExport.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Match the DotRecast version ParadiseExport.Core vendors so the navmesh format is identical. -->
    <PackageReference Include="DotRecast.Core" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Detour" Version="2026.1.3" />
  </ItemGroup>

</Project>
