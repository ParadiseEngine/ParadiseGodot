<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DotRecast implementation of ParadiseGame's INavigationMesh — the single shared nav backend
    used by BOTH the Godot presentation and the Paradise Engine runtime (the BankHeist.Navigation.Detour
    analog). Engine-agnostic; right-handed. Reuses ParadiseExport's NavMeshBinaryWriter.BuildNavMesh
    to turn RH triangles into a queryable DtNavMesh.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ParadiseGame.Navigation.Detour</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ParadiseGame\ParadiseGame.csproj" />
    <ProjectReference Include="..\ParadiseExport\ParadiseExport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Match the DotRecast version ParadiseExport vendors so the navmesh format is identical. -->
    <PackageReference Include="DotRecast.Core" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Detour" Version="2026.1.3" />
  </ItemGroup>

</Project>
