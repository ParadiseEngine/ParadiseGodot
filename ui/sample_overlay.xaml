<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent">
  <Grid.Resources>
    <!-- Self-contained button (no theme, no fonts): a rounded chip whose fill answers
         hover/press — the visual proof that sim-thread input reaches the view. -->
    <Style x:Key="ChipButton" TargetType="Button">
      <Setter Property="Width" Value="72"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Margin" Value="6,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chip" CornerRadius="10" Background="#C8355A7C"
                    BorderBrush="#FF7FB2D9" BorderThickness="1.5">
              <Ellipse Width="14" Height="14" Fill="#FFDCE9F5"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="#E04C82B4"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="#FFE8A33D"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Grid.Resources>

  <!-- bottom action bar -->
  <Border Height="72" VerticalAlignment="Bottom" HorizontalAlignment="Center"
          Margin="0,0,0,24" Padding="18,0" CornerRadius="18">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#D91C2B3A" Offset="0"/>
        <GradientStop Color="#D90F1822" Offset="1"/>
      </LinearGradientBrush>
    </Border.Background>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Button Style="{StaticResource ChipButton}"/>
      <Button Style="{StaticResource ChipButton}"/>
      <Button Style="{StaticResource ChipButton}"/>
      <Button Style="{StaticResource ChipButton}"/>
    </StackPanel>
  </Border>

  <!-- top-right status jewel: radial gradient + slow pulse (proves sim-driven animation) -->
  <Ellipse Width="46" Height="46" HorizontalAlignment="Right" VerticalAlignment="Top"
           Margin="0,20,24,0" x:Name="Jewel">
    <Ellipse.Fill>
      <RadialGradientBrush>
        <GradientStop Color="#FF69D98C" Offset="0"/>
        <GradientStop Color="#3369D98C" Offset="0.7"/>
        <GradientStop Color="#0069D98C" Offset="1"/>
      </RadialGradientBrush>
    </Ellipse.Fill>
    <Ellipse.Triggers>
      <EventTrigger RoutedEvent="FrameworkElement.Loaded">
        <BeginStoryboard>
          <Storyboard RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="Jewel"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0" To="0.35" Duration="0:0:1.2"/>
          </Storyboard>
        </BeginStoryboard>
      </EventTrigger>
    </Ellipse.Triggers>
  </Ellipse>
</Grid>
