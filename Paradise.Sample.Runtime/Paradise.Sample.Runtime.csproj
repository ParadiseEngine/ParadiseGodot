<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Paradise.Sample.Runtime</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- NativeAOT on publish only (dotnet publish -c Release -r <rid>); regular build/run are
         unaffected. Set here, NOT as a CLI global property — that leaks into the netstandard2.0
         source-generator projects, which cannot AOT (NETSDK1207). -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Sample.Game\Paradise.Sample.Game.csproj" />
    <ProjectReference Include="..\Paradise.Sample.ImGui\Paradise.Sample.ImGui.csproj" />
    <ProjectReference Include="..\Paradise.Sample.Ui\Paradise.Sample.Ui.csproj" />
    <ProjectReference Include="..\Paradise.Sample.Game.Navigation.Detour\Paradise.Sample.Game.Navigation.Detour.csproj" />
    <PackageReference Include="Paradise.Export" Version="0.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Published engine packages. -->
    <PackageReference Include="Paradise.Rendering" Version="0.3.0" />
    <PackageReference Include="Paradise.Rendering.WebGPU" Version="0.3.0" />
    <PackageReference Include="Paradise.Rendering.Pbr" Version="0.3.0" />
    <PackageReference Include="Paradise.Assets.Gltf" Version="0.3.0" />
    <PackageReference Include="Paradise.Assets.Textures" Version="0.3.0" />
    <PackageReference Include="Paradise.Ui.ImGui" Version="0.3.0" />
    <PackageReference Include="Paradise.Ui.Noesis" Version="0.3.0" />
    <PackageReference Include="ppy.SDL3-CS" Version="2026.320.0" />
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) And '$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">
    <!-- Ktx2.NET ships libktx natives for win-x64/linux-x64 only; the Paradise.Assets.Textures
         package deliberately carries no natives. Vendored dylib (KTX-Software 4.4.2, Apache-2.0,
         same binary the engine repo vendors) so DllImport("ktx") resolves on Apple Silicon.
         Flows transitively to referencing test projects' output. -->
    <None Include="..\third_party\ktx\osx-arm64\libktx.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libktx.dylib</Link>
      <Visible>false</Visible>
    </None>
  </ItemGroup>

</Project>
