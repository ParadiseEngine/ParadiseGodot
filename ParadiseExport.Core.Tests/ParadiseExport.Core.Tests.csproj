<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Unit tests for the engine-neutral export Core. Uses TUnit on the Microsoft.Testing.Platform
    runner, matching ~/proj/ParadiseEngine's test stack. Runs with plain `dotnet test` — no Godot.
    Home for the Phase 1+ validation suite (JSON round-trip, color packing, matrix column-major
    order, DotRecast writer). See MIGRATION.md.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Benign: Microsoft.Testing.Platform 2.0.2 ships resource locales the .NET 10 SDK
         doesn't recognize. Not our bug; silence the noise. -->
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.57.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ParadiseExport.Core/ParadiseExport.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Golden fixtures (real Unity exports) copied next to the test assembly. -->
    <None Include="Fixtures/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
