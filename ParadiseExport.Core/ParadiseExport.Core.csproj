<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Engine-neutral export core. NO Godot reference by design: this is where the verbatim
    ports from ParadiseUnityEditor's Runtime/Data + serialization + DotRecast navmesh +
    Blender/toktx orchestration live, and it must stay buildable/testable with plain
    `dotnet build` / `dotnet test`. See MIGRATION.md.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ParadiseExport.Core</RootNamespace>
    <!-- Required so Godot can load this referenced library into its assembly load context. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Match the DotRecast version vendored by ParadiseUnityEditor so the navmesh binary
         format stays identical to what the Paradise Engine runtime expects. -->
    <PackageReference Include="DotRecast.Core" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Detour" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Recast" Version="2026.1.3" />
  </ItemGroup>

</Project>
