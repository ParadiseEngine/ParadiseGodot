<Project Sdk="Microsoft.NET.Sdk">

  <!-- TUnit tests run without Godot. Test pure logic; native Godot calls need an editor probe. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Microsoft.Testing.Platform includes locales the .NET 10 SDK does not recognize. -->
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
    <!-- Include the addon's editor-only API. -->
    <DefineConstants>$(DefineConstants);TOOLS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.57.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Godot.Editor\Paradise.Godot.Editor.csproj" />
  </ItemGroup>

</Project>
