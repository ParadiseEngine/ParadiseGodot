<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Paradise.Sample.Runtime.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.11.16" />
    <!-- KtxV5CompatibilityTests drives the export-side GLB texture pass directly. It moved out of
         Paradise.Export at 0.34, so it no longer arrives through the runtime project. -->
    <PackageReference Include="Paradise.Assets.Pipeline" Version="0.40.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Sample.Runtime\Paradise.Sample.Runtime.csproj" />
  </ItemGroup>
</Project>
