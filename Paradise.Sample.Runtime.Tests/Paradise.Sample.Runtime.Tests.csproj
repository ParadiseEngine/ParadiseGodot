<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Paradise.Sample.Runtime.Tests</RootNamespace>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- UiStagingRules is addon code (#if TOOLS) but deliberately Godot-free so its staging
         decisions are unit-testable here without a Godot runtime. It is linked as SOURCE rather
         than reached through a ProjectReference to Paradise.Godot.Editor on purpose: that would
         drag GodotSharp into a test project that must not need a Godot runtime. -->
    <DefineConstants>$(DefineConstants);TOOLS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Paradise.Godot.Editor\Export\UiStagingRules.cs" Link="UiStagingRules.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.11.16" />
    <!-- KtxV5CompatibilityTests drives the export-side GLB texture pass directly. It moved out of
         Paradise.Export at 0.34, so it no longer arrives through the runtime project. -->
    <PackageReference Include="Paradise.Assets.Pipeline" Version="0.35.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Sample.Runtime\Paradise.Sample.Runtime.csproj" />
  </ItemGroup>
</Project>
