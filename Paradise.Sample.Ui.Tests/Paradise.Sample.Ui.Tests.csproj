<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The shared UI cores (ImGui frame + snapshot handoff) and the host-agnostic ViewModels
    headless: cimgui is CPU-only so the full ImGui pipeline runs without any GPU or window,
    and the Noesis overlay ViewModel is pure INotifyPropertyChanged (the Noesis view lifecycle
    itself now lives in the engine's Paradise.Ui.Noesis.Host package and is tested there).
    TUnit on Microsoft.Testing.Platform, matching the repo's test stack.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.57.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Sample.Ui\Paradise.Sample.Ui.csproj" />
  </ItemGroup>

</Project>
