<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A minimal "Space Odyssey" progression sim — the immortal-cultivation architecture (single-variable
    components, owner systems, an intent→system→event seam, the SystemEvents deferred bus + managed
    Emit) re-skinned as a sci-fi warp voyage. Engine-agnostic: depends only on Paradise.ECS, so both
    hosts (Godot + the standalone runtime) drive the identical sim. See CONVENTIONS.md "Odyssey sample".
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Paradise.Sample.Odyssey</RootNamespace>
    <!-- Required so Godot can load this library into its collectible assembly load context. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Published engine package; Paradise.ECS ships its source generator as an analyzer. -->
    <PackageReference Include="Paradise.ECS" Version="0.18.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Paradise.ECS" />
  </ItemGroup>

</Project>
