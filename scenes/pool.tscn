; Procedural animated ball materials — the .NET runtime shader generates each surface from a noise
; recipe (metadata/material_kind) animated by time. albedo_color is the Godot-editor fallback; the
; runtime uses the recipe + color_a/color_b + noise_scale/flow_speed/emissive_strength metadata.
; (Godot play mode renders the flat albedo_color until the GDShader mirror lands.)
[sub_resource type="StandardMaterial3D" id="mat_pool_cue"]
next_pass = SubResource("proc_cue")
albedo_color = Color(0.9, 0.9, 0.95, 1)
roughness = 0.16
metadata/material_kind = "nebula"
