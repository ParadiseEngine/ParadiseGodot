<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DotRecast implementation of Paradise.Sample.Game's INavigationMesh — the single shared nav backend
    used by BOTH the Godot presentation and the Paradise Engine runtime (the BankHeist.Navigation.Detour
    analog). Engine-agnostic; right-handed. Reuses Paradise.Export's NavMeshBinaryWriter.BuildNavMesh
    to turn RH triangles into a queryable DtNavMesh.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Paradise.Sample.Game.Navigation.Detour</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Paradise.Sample.Game\Paradise.Sample.Game.csproj" />
    <PackageReference Include="Paradise.Export" Version="0.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Match the DotRecast version Paradise.Export pins so the navmesh format is identical. -->
    <PackageReference Include="DotRecast.Core" Version="2026.1.3" />
    <PackageReference Include="DotRecast.Detour" Version="2026.1.3" />
  </ItemGroup>

</Project>
