; Paradise Engine starter project — Godot .NET.
; The addon is a NuGet package (see ParadiseStarter.csproj), not a copy in this repo, so
; addons/paradise does not exist until the first C# build places it there. Godot will report
; the plugin below as missing until then — build once, reload, and it resolves.
; Then run Project > Tools > Paradise/Project Setup and follow docs/quickstart.

config_version=5

[application]

config/name="Paradise Starter"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
run/main_scene="res://scenes/main.tscn"

[dotnet]

project/assembly_name="ParadiseStarter"

[editor_plugins]

enabled=PackedStringArray("res://addons/paradise/plugin.cfg")
