<Project Sdk="Godot.NET.Sdk/4.7.0">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>ParadiseStarter</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Paradise authoring addon. It brings Paradise.Export with it at the version it was
         built against, and on first build it places its own res:// half into addons/paradise -
         plugin.cfg plus the two scripts scenes bind to. Commit what it writes; Godot mints the
         .uid files beside them on first import, and those belong in the repo too. -->
    <PackageReference Include="Paradise.Godot.Editor" Version="0.25.0" />
  </ItemGroup>

</Project>
