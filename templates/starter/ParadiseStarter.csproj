<Project Sdk="Godot.NET.Sdk/4.7.0">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>ParadiseStarter</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- Installs addons/paradise/ on build and supplies Paradise.Export. Commit the installed
         files and the .uid files Godot creates on import. -->
    <PackageReference Include="Paradise.Godot.Editor" Version="0.40.0" />
  </ItemGroup>

</Project>
