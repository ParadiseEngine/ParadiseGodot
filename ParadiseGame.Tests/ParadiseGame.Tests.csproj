<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless proof that the shared simulation + DotRecast navmesh run WITHOUT any engine (Godot or
    ParadiseEngine) — the BankHeist "same runner off-Unity" guarantee. TUnit on Microsoft.Testing.Platform,
    matching the repo's test stack. Run via `dotnet test` with this project.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Microsoft.Testing.Platform ships resource locales the .NET 10 SDK doesn't recognize. -->
    <NoWarn>$(NoWarn);NETSDK1188</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.57.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ParadiseGame\ParadiseGame.csproj" />
    <ProjectReference Include="..\ParadiseGame.Navigation.Detour\ParadiseGame.Navigation.Detour.csproj" />
  </ItemGroup>

</Project>
