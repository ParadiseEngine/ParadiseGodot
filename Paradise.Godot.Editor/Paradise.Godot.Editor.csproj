<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="AddonVersion.props" />

  <!-- Use a plain library: Godot.NET.Sdk requires project.godot beside the project.
    Ship the assembly in lib/, resource scripts in addon/, and installation targets in build/. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ParadiseGodot</RootNamespace>
    <!-- Reload with the consuming game's editor assembly. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- This assembly is editor-only; include all #if TOOLS code. -->
    <DefineConstants>$(DefineConstants);TOOLS</DefineConstants>
    <!-- ScriptPathAttributeGenerator fails without GodotProjectDir. Only addon/ files need
         ScriptPath; keep the property/method generators enabled for interop. -->
    <NoWarn>$(NoWarn);CS8785</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <Version>$(ParadiseGodotAddonPackageVersion)</Version>
    <PackageId>Paradise.Godot.Editor</PackageId>
    <Authors>ParadiseEngine</Authors>
    <Description>Edit Paradise Engine prefab documents in Godot, author game components, and build and play through the Paradise CLI.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>godot;paradise;editor;authoring</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GodotSharp" Version="4.7.1" />
    <!-- Editor APIs require this assembly. Do not reference the addon from exported runtime projects. -->
    <PackageReference Include="GodotSharpEditor" Version="4.7.1" />
    <PackageReference Include="Godot.SourceGenerators" Version="4.7.1" PrivateAssets="all" />
    <!-- Pin the authoring contract here so consumers need no separate version references. -->
    <PackageReference Include="Paradise.Export" Version="0.40.0" />
    <PackageReference Include="Paradise.Authoring" Version="0.40.0" />
    <!-- Asset project layout, document formats, and import/build tools. -->
    <PackageReference Include="Paradise.Assets.Project" Version="0.40.0" />
    <PackageReference Include="Paradise.Assets.Documents" Version="0.40.0" />
    <PackageReference Include="Paradise.Assets.Pipeline" Version="0.40.0" />
  </ItemGroup>

  <!-- Consumers compile addon/ scripts after installation; exclude them from this assembly. -->
  <ItemGroup>
    <Compile Remove="addon/**/*.cs" />
    <None Include="addon/**/*" Pack="true" PackagePath="addon/" />
    <None Include="build/Paradise.Godot.Editor.targets" Pack="true" PackagePath="build/" />
    <None Include="$(IntermediateOutputPath)Paradise.Godot.Editor.props" Pack="true" PackagePath="build/" />
  </ItemGroup>

  <!-- Export the package version through a NuGet-imported props file. The consumer's
    $(Version) describes its own project, not this package. -->
  <Target Name="GenerateAddonVersionProps" BeforeTargets="Build;GenerateNuspec">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile
        File="$(IntermediateOutputPath)Paradise.Godot.Editor.props"
        Overwrite="true"
        Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;ParadiseGodotAddonPackageVersion&gt;$(Version)&lt;/ParadiseGodotAddonPackageVersion&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;" />
  </Target>

</Project>
