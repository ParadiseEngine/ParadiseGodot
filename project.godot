; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ParadiseGodot"
run/main_scene="res://scenes/sample.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"

[debug]

file_logging/enable_file_logging=true

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="ParadiseGodot"

[editor_plugins]

enabled=PackedStringArray("res://addons/paradise_export/plugin.cfg")

[navigation]

3d/default_cell_size=0.1
3d/default_cell_height=0.1

[paradise]

physics/min_speed=0.005
physics/skin=0.02
physics/push_strength=1.2
physics/default_static_restitution=0.4

[physics]

2d/physics_engine="Dummy"
3d/physics_engine="Dummy"

[rendering]

rendering_device/driver.windows="d3d12"
