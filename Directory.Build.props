<Project>

  <!-- Write obj/.gdignore before compilation so Godot does not import generated C# files.
    Keep this target in .props: a local Directory.Build.targets would shadow the workspace's
    engine-source override and silently build against published packages instead. -->

  <Target Name="ParadiseIgnoreIntermediateInGodot"
          BeforeTargets="CoreCompile"
          Condition="'$(BaseIntermediateOutputPath)' != ''">
    <MakeDir Directories="$(BaseIntermediateOutputPath)" />
    <WriteLinesToFile File="$(BaseIntermediateOutputPath).gdignore"
                      Lines="Not res:// content. MSBuild's intermediate output; written by Directory.Build.props."
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
