<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Engine-agnostic runtime simulation shared between the Godot presentation (ParadiseGodot) and the
    Paradise Engine runtime — the "BankHeist.Core" analog. NO Godot / DotRecast references: it depends
    only on Paradise.ECS. All logic is right-handed (Y-up, −Z forward), matching the export contract.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>Paradise.Sample.Game</RootNamespace>
    <!-- Required so Godot can load this library into its collectible assembly load context. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Published engine packages; Paradise.ECS ships its source generator as an analyzer. -->
    <PackageReference Include="Paradise.ECS" Version="0.2.0" />
    <PackageReference Include="Paradise.Physics" Version="0.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Paradise.ECS" />
  </ItemGroup>

</Project>
