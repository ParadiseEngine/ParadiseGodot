<Project Sdk="Godot.NET.Sdk/4.7.1">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>ParadiseGodot</RootNamespace>
    <!-- Required for Godot editor hot-reload of this assembly. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- The shared Paradise.Sample.Pool.* libs are their own projects; keep their sources out of this
         assembly's recursive **/*.cs glob. -->
    <Compile Remove="Paradise.Sample.Pool/**/*.cs" />
    <Compile Remove="Paradise.Sample.Pool.Tests/**/*.cs" />
    <!-- Paradise.Sample.Runtime is the standalone SDL/engine-renderer host; keep its sources (and its
         obj/ generated AssemblyInfo — CS0579 duplicates otherwise) out of this glob. -->
    <Compile Remove="Paradise.Sample.Runtime/**/*.cs" />
    <Compile Remove="Paradise.Sample.Runtime.Tests/**/*.cs" />
    <!-- ParadiseEngine is a local-only symlink for reference (see .gitignore);
         keep its sources out of this assembly's recursive **/*.cs glob. -->
    <Compile Remove="ParadiseEngine/**/*.cs" />
    <Compile Remove="NoesisSpike/**/*.cs" />
    <Compile Remove="Paradise.Sample.Ui/**/*.cs" />
    <Compile Remove="Paradise.Sample.Ui.Tests/**/*.cs" />
    <!-- The ImGui sample core is its own project (shared with Paradise.Sample.Runtime). -->
    <Compile Remove="Paradise.Sample.ImGui/**/*.cs" />
    <!-- The "Space Odyssey" sim core + its tests are their own projects; keep their sources out
         of this assembly's recursive **/*.cs glob (it flows in transitively via the ImGui sample). -->
    <Compile Remove="Paradise.Sample.Odyssey/**/*.cs" />
    <Compile Remove="Paradise.Sample.Odyssey.Tests/**/*.cs" />
    <!-- The addon is its own packable project now. Its sources must not also compile into this
         assembly, or every addon type would exist twice. What this assembly still compiles from
         the addon is addons/paradise/*.cs - the two res:// shims, which have to live in the
         Godot project because scenes bind scripts by path. -->
    <Compile Remove="Paradise.Godot.Editor/**/*.cs" />
    <Compile Remove="Paradise.Godot.Editor.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The addon. Paradise.Export and Paradise.Authoring arrive THROUGH it and are deliberately
         not restated here: the addon assembly declares the versions it was compiled against, so
         there is no longer a second place for them to drift. Restating them by hand is how the
         addon once silently built against a schema v1 model after the engine had moved to v2. -->
    <ProjectReference Include="Paradise.Godot.Editor/Paradise.Godot.Editor.csproj" />
    <ProjectReference Include="Paradise.Sample.Pool/Paradise.Sample.Pool.csproj" />
    <!-- Play-mode UI overlays: shared renderer-independent cores + the managed Noesis WebGPU
         render device (headless Dawn + readback in the Godot host). Real sibling path for the
         engine project (NOT the in-tree symlink, which breaks restore). -->
    <ProjectReference Include="Paradise.Sample.Ui/Paradise.Sample.Ui.csproj" />
    <ProjectReference Include="Paradise.Sample.ImGui/Paradise.Sample.ImGui.csproj" />
    <!-- The "Space Odyssey" sim core (OdysseyBridge drives its 3D render + threaded snapshot runner). -->
    <ProjectReference Include="Paradise.Sample.Odyssey/Paradise.Sample.Odyssey.csproj" />
    <!-- The engine-neutral UI input contract the bridges enqueue events into. -->
    <PackageReference Include="Paradise.Ui" Version="0.25.0" />
    <!-- The shared sim-thread NoesisViewCore. This host does NOT use the package's
         NoesisOverlayRenderer: NoesisTextureOverlay drives the render device itself, on its
         own headless Dawn device with a CPU readback into a Godot ImageTexture. -->
    <!-- The managed Noesis WebGPU render device NoesisTextureOverlay owns directly. -->
    <PackageReference Include="Paradise.Ui.Noesis" Version="0.25.0" />
  </ItemGroup>

  <!--
    Dogfood the payload placement. A ProjectReference does not carry a package's build/ assets, so
    import the targets by hand here; consuming games get this automatically from the package. It
    keeps this repo's own addons/paradise/ shims from drifting out of sync with the payload the
    package ships, which is the exact failure the packaging exists to remove.
  -->
  <Import Project="Paradise.Godot.Editor/AddonVersion.props" />
  <Import Project="Paradise.Godot.Editor/build/Paradise.Godot.Editor.targets" />

</Project>
