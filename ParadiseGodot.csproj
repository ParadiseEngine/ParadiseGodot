<Project Sdk="Godot.NET.Sdk/4.7.1">

  <!-- Minimal addon consumer for installation and editor-reload checks; no game content. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>ParadiseGodot</RootNamespace>
    <!-- Required for Godot editor hot-reload. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- Exclude the optional local engine symlink from the recursive source glob. -->
    <Compile Remove="ParadiseEngine/**/*.cs" />
    <!-- Compile the addon and tests in their own projects to avoid duplicate types.
         This project compiles only the installed addons/paradise/ scripts. -->
    <Compile Remove="Paradise.Godot.Editor/**/*.cs" />
    <Compile Remove="Paradise.Godot.Editor.Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The addon supplies the engine dependencies and their versions. -->
    <ProjectReference Include="Paradise.Godot.Editor/Paradise.Godot.Editor.csproj" />
  </ItemGroup>

  <!-- ProjectReference does not import NuGet build assets. Import them here to exercise
    the same payload installation as consuming games. -->
  <Import Project="Paradise.Godot.Editor/AddonVersion.props" />
  <Import Project="Paradise.Godot.Editor/build/Paradise.Godot.Editor.targets" />

</Project>
