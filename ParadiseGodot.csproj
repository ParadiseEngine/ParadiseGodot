<Project Sdk="Godot.NET.Sdk/4.7.0">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>ParadiseGodot</RootNamespace>
    <!-- Required for Godot editor hot-reload of this assembly. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <!-- ParadiseExport is its own project; keep its sources out of the Godot assembly's
       recursive **/*.cs glob so they aren't compiled twice. -->
  <ItemGroup>
    <Compile Remove="ParadiseExport/**/*.cs" />
    <Compile Remove="ParadiseExport.Tests/**/*.cs" />
    <!-- The shared Paradise.Sample.Game.* libs are their own projects; keep their sources out of this
         assembly's recursive **/*.cs glob. -->
    <Compile Remove="Paradise.Sample.Game/**/*.cs" />
    <Compile Remove="Paradise.Sample.Game.Tests/**/*.cs" />
    <Compile Remove="Paradise.Sample.Game.Navigation.Detour/**/*.cs" />
    <!-- Paradise.Sample.Runtime is the standalone SDL/engine-renderer host; keep its sources (and its
         obj/ generated AssemblyInfo — CS0579 duplicates otherwise) out of this glob. -->
    <Compile Remove="Paradise.Sample.Runtime/**/*.cs" />
    <Compile Remove="Paradise.Sample.Runtime.Tests/**/*.cs" />
    <!-- ParadiseEngine is a local-only symlink for reference (see .gitignore);
         keep its sources out of this assembly's recursive **/*.cs glob. -->
    <Compile Remove="ParadiseEngine/**/*.cs" />
    <Compile Remove="NoesisSpike/**/*.cs" />
    <Compile Remove="Paradise.Sample.Ui/**/*.cs" />
    <Compile Remove="Paradise.Sample.Ui.Tests/**/*.cs" />
    <!-- The ImGui sample core is its own project (shared with Paradise.Sample.Runtime). -->
    <Compile Remove="Paradise.Sample.ImGui/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="ParadiseExport/ParadiseExport.csproj" />
    <ProjectReference Include="Paradise.Sample.Game/Paradise.Sample.Game.csproj" />
    <ProjectReference Include="Paradise.Sample.Game.Navigation.Detour/Paradise.Sample.Game.Navigation.Detour.csproj" />
    <!-- Play-mode UI overlays: shared renderer-independent cores + the managed Noesis WebGPU
         render device (headless Dawn + readback in the Godot host). Real sibling path for the
         engine project (NOT the in-tree symlink, which breaks restore). -->
    <ProjectReference Include="Paradise.Sample.Ui/Paradise.Sample.Ui.csproj" />
    <ProjectReference Include="Paradise.Sample.ImGui/Paradise.Sample.ImGui.csproj" />
    <PackageReference Include="Paradise.Ui.Noesis" Version="0.2.0" />
  </ItemGroup>

</Project>
